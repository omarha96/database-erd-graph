# Server
PORT=3000

# Postgres connection used by GET /api/schema to introspect a live
# database and generate an ER diagram from it.
#
# Option A: a single connection string (takes priority if set)
# DATABASE_URL=postgres://user:password@localhost:5432/mydb

# Option B: discrete parts (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# Schema to introspect (default: public)
PGSCHEMA=public
