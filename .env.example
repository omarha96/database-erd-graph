# Copy to .env (which is git-ignored) and fill in. Never commit .env.
#
# All of this is optional: the connection menu in the app (server icon)
# can point the viewer at any Postgres server. These values only prefill
# it. The password stays on the server: it is never sent to the browser,
# never compiled into a build, and only used for this same server + user.

# HTTP port and bind address of server.js
PORT=4440
# HOST=127.0.0.1    # default 0.0.0.0 (reachable from your network)

# Default Postgres connection, either as one URL (takes priority)...
# DATABASE_URL=postgres://user:password@localhost:5432/mydb?sslmode=require

# ...or as discrete parts
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# PGDATABASE=postgres
# PGSSLMODE=require

# Schema to introspect (default: public)
# PGSCHEMA=public

# Extra origins allowed to call the API cross-origin, comma-separated
# (the desktop app's origins are always allowed)
# CORS_ORIGINS=
