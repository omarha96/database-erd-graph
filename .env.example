# Server
PORT=4440

# Default Postgres connection. Everything here is optional: the connection
# menu in the toolbar (server icon) can point the viewer at any server,
# and these values only prefill it. The password is never sent to the
# browser, and is only used for this same server + user.
#
# Option A: a single connection string (takes priority if set)
# DATABASE_URL=postgres://user:password@localhost:5432/mydb?sslmode=require

# Option B: discrete parts (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
# PGDATABASE=postgres
# PGSSLMODE=require

# Schema to introspect (default: public)
PGSCHEMA=public
