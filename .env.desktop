# Build settings for the desktop app (`npm run desktop`). Committed on
# purpose: it holds no secrets.
#
# WARNING: every VITE_* value is compiled into the app bundle and visible to
# anyone who has the app. Never put passwords, tokens or connection strings
# here; the build fails if a VITE_* variable looks like a secret.
VITE_DESKTOP=1
VITE_API_BASE=http://localhost:4440
